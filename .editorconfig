# EditorConfig — https://editorconfig.org
# Cross-editor baseline for Sublime, Vim, Emacs, Zed, etc. — kept in sync
# with .prettierrc, .vscode/settings.json, and .idea/codeStyles/Project.xml.
root = true

[*]
indent_style = space
indent_size = 2
tab_width = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

# Markdown allows trailing spaces for hard line breaks.
[*.md]
trim_trailing_whitespace = false
max_line_length = off
