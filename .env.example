# =============================================================================
# Environment Variables — Example
# =============================================================================
# Copy this file to .env.local and fill in the values:
#
#     cp .env.example .env.local
#
# Rules:
#   - .env.local is git-ignored and stays on your machine.
#   - Every variable used in the app must be declared here AND in src/env.ts
#     (Zod schema in @t3-oss/env-nextjs validates it at build time).
#   - NEXT_PUBLIC_* variables are inlined into the client bundle — never put
#     secrets there.
# =============================================================================


# -----------------------------------------------------------------------------
# Public — exposed to the browser. Safe to commit example values.
# -----------------------------------------------------------------------------

# Base URL of the running app. Used for absolute URLs, OG images, redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Example: analytics / feature flags / public API keys.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oxxxxxxx.ingest.sentry.io/xxxxxxx


# -----------------------------------------------------------------------------
# Server-only — never exposed to the browser. Real values stay in .env.local.
# -----------------------------------------------------------------------------

# Database connection (uncomment and add to src/env.ts → server schema):
# DATABASE_URL=postgres://user:password@localhost:5432/app

# Auth secret for sessions / JWT (generate with: openssl rand -base64 32):
# AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Third-party API credentials:
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# Build-time only (Next.js / tooling)
# -----------------------------------------------------------------------------

# Set to "true" before `npm run build` to open the bundle analyser report:
# ANALYZE=true
